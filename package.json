{
  "name": "yopass-site",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "docs:fetch": "sh scripts/fetch-docs.sh",
    "docs:generate": "docusaurus clean-api-docs all && docusaurus gen-api-docs all",
    "prestart": "npm run docs:fetch && npm run docs:generate",
    "start": "docusaurus start",
    "build": "docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "docusaurus serve",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run docs:fetch && npm run docs:generate"
  },
  "dependencies": {
    "@docusaurus/core": "^3.10.2",
    "@docusaurus/plugin-client-redirects": "^3.10.2",
    "@docusaurus/preset-classic": "^3.10.2",
    "clsx": "^2.0.0",
    "docusaurus-plugin-openapi-docs": "^5.2.0",
    "docusaurus-plugin-sass": "^0.2.7",
    "docusaurus-theme-openapi-docs": "^5.2.0",
    "prism-react-renderer": "^2.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.3.1",
    "sass": "^1.108.2"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.10.2",
    "@docusaurus/tsconfig": "^3.10.2",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 3 chrome version",
      "last 3 firefox version",
      "last 5 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
